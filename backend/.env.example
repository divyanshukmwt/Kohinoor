# Backend Environment Variables (Render)
# Set these in Render Dashboard -> Environment

# 1. Google Gemini API Key & Dynamic Model
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-2.5-flash | gemini-2.5-pro | gemini-2.5-flash-lite | gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 2. CORS Allowed Origins (Your Vercel URL, comma-separated, or * for all)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# 3. Database (Leave USE_POSTGRES=false to use auto-seeded built-in SQLite + Knowledge Base)
USE_POSTGRES=false
DATABASE_URL=
