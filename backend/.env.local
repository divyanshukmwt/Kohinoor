# ─────────────────────────────────────────────────────────────
# Éclat Platform — Backend Environment
# ─────────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql://eclat_user:eclat_pass@localhost:5432/eclat_db

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=eclat-jewellery

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Admin API key (for /api/admin/* routes)
ADMIN_API_KEY=eclat-dev-key

# Set to "true" to log all SQL queries
DB_ECHO=false
